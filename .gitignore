# Dependencies
**/node_modules/

# Environment variables
**/.env
**/.env.*
!**/.env.example

# Build output
**/dist/
**/build/
**/.vite/
**/coverage/
**/dist-ssr/

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Runtime files
**/*.pid
**/*.seed
**/*.pid.lock

# Cache
**/.cache/
**/.parcel-cache/
**/.eslintcache
**/.stylelintcache
**/*.tsbuildinfo

# Temporary files
**/tmp/
**/temp/
**/*.tmp

# OS files
**/.DS_Store
**/Thumbs.db
**/Desktop.ini

# IDE / editor
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
**/.idea/
**/*.swp
**/*.swo
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Vercel
**/.vercel/

# Netlify
**/.netlify/

# GitHub config is kept trackable
!.github/
